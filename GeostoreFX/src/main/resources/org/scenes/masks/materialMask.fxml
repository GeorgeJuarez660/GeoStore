<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="153.0" prefWidth="300.0" stylesheets="@../../css/font_geostore.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.controller.masks.MaterialMaskController">
   <children>
      <HBox alignment="TOP_CENTER" maxWidth="500.0" prefHeight="153.0" prefWidth="300.0" spacing="20.0" style="-fx-background-color: #3F51B5; -fx-background-radius: 12;">
         <children>
            <VBox alignment="CENTER" prefWidth="260.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_RIGHT" prefHeight="31.0" spacing="5.0">
                     <children>
                        <Label alignment="CENTER_RIGHT" contentDisplay="RIGHT" styleClass="label-font" text="%mask.material.nameIT" textAlignment="RIGHT" textFill="WHITE" wrapText="true">
                           <font>
                              <Font size="8.0" />
                           </font>
                        </Label>
                        <TextField fx:id="nameIt" onMouseEntered="#showPopOver" onMouseExited="#hidePopOver" prefHeight="25.0" style="-fx-background-radius: 7;" styleClass="label-font-min-title">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </TextField>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_RIGHT" prefHeight="31.0" spacing="5.0">
                     <children>
                        <Label alignment="CENTER_RIGHT" contentDisplay="RIGHT" styleClass="label-font" text="%mask.material.nameEN" textAlignment="RIGHT" textFill="WHITE" wrapText="true">
                           <font>
                              <Font size="8.0" />
                           </font>
                        </Label>
                        <TextField fx:id="nameEn" onMouseEntered="#showPopOver" onMouseExited="#hidePopOver" prefHeight="25.0" style="-fx-background-radius: 7;" styleClass="label-font-min-title">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </TextField>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_RIGHT" prefHeight="31.0" spacing="5.0">
                     <children>
                        <Label alignment="CENTER_RIGHT" contentDisplay="RIGHT" styleClass="label-font" text="%mask.material.nameJA" textAlignment="RIGHT" textFill="WHITE" wrapText="true">
                           <font>
                              <Font size="8.0" />
                           </font>
                        </Label>
                        <TextField fx:id="nameJa" onMouseEntered="#showPopOver" onMouseExited="#hidePopOver" prefHeight="25.0" style="-fx-background-radius: 7;" styleClass="label-font-min-title">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </TextField>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
