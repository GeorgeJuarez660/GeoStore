<?xml version="1.0" encoding="UTF-8" ?>
<!--Scontrino GeoStore per l'ordinazione prodotto-->
<!DOCTYPE Scontrino SYSTEM "formatReceipt.dtd">
<?xml-stylesheet type="text/xsl" href="styleReceipt.xsl" ?>
<Scontrino>
    <Intestazione>
        <nomeNegozio>GeoStore</nomeNegozio>
        <via>Negozio virtuale</via>
    </Intestazione>
    <Corpo>
        <TitoloTabella>
            <colonnaT1>PRODOTTO</colonnaT1>
            <colonnaT2>QUANTITÀ</colonnaT2>
            <colonnaT3>PREZZO U.</colonnaT3>
        </TitoloTabella>
        <CorpoTabella>
            <colonnaC1>xxPRODUCTxx</colonnaC1>
            <colonnaC2>xxQUANTITYxx</colonnaC2>
            <colonnaC3>xxDEFPRICExx</colonnaC3>
        </CorpoTabella>
    </Corpo>
    <PiedeTotale>
        <colonnaPT>TOTALE</colonnaPT>
        <colonnaPC>xxTOTALPRICExx</colonnaPC>
    </PiedeTotale>
    <Didascalia>
        <DidascaliaTitolo>
            <colonnaDT>N. Documento:</colonnaDT>
            <colonnaNT>Cliente</colonnaNT>
        </DidascaliaTitolo>
        <DidascaliaCorpo>
            <colonnaDC>xxCHMxx</colonnaDC>
            <colonnaNC>xxUSERxx</colonnaNC>
        </DidascaliaCorpo>
    </Didascalia>

</Scontrino>