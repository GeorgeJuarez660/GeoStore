<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="800.0" maxWidth="1000.0" minHeight="0.0" minWidth="200.0" prefHeight="600.0" prefWidth="800.0" style="-fx-alignment: center;" styleClass="label-font" stylesheets="@../css/font_geostore.css, @../css/color_geostore.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.controller.QuestionController">
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="103.0" fitWidth="170.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/geostore_sign.png" />
               </image>
            </ImageView>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="TOP_CENTER" layoutX="10.0" layoutY="10.0" maxWidth="643.0" prefHeight="189.0" prefWidth="643.0" style="-fx-background-color: #D3F3FF; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #2352A4; -fx-border-width: 2;">
               <children>
                  <VBox alignment="CENTER" prefWidth="643.0" spacing="10.0">
                     <children>
                        <Label fx:id="request" alignment="CENTER" contentDisplay="CENTER" prefHeight="38.0" prefWidth="454.0" styleClass="text_field2-font" text="Sei sicur* di voler /fare un azione/?" textAlignment="CENTER" textFill="#2352a4" wrapText="true" />
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
                           <children>
                              <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#accept" prefHeight="30.0" prefWidth="250.0" style="-fx-background-radius: 10; " styleClass="action" text="%question.buttonYes" textAlignment="CENTER" textFill="WHITE" />
                              <Button fx:id="back" alignment="CENTER" contentDisplay="CENTER" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#deny" prefHeight="30.0" prefWidth="250.0" style="-fx-background-radius: 10; " text="%question.buttonNo" textAlignment="CENTER" textFill="WHITE" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox prefHeight="40.0" prefWidth="600.0" style="-fx-background-color: #306FDB;" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
