<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="610.0" stylesheets="@../css/font_geostore.css, @../css/color_geostore.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.controller.ReadOrderTotalPriceController">
   <children>
      <HBox alignment="CENTER" prefHeight="55.0">
         <children>
            <ImageView fitHeight="103.0" fitWidth="170.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/geostore_sign.png" />
               </image>
            </ImageView>
         </children>
      </HBox>
      <HBox alignment="TOP_CENTER" prefHeight="50.0">
         <children>
            <Label fx:id="title" alignment="CENTER" contentDisplay="CENTER" styleClass="label-font" text="XXX" textAlignment="CENTER" textFill="#2352a4" wrapText="true" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets top="10.0" />
               </HBox.margin>
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox fx:id="item" alignment="TOP_CENTER" layoutX="10.0" layoutY="112.0" minWidth="20.0" prefHeight="241.0" prefWidth="610.0">
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <HBox alignment="TOP_CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#research" prefHeight="30.0" prefWidth="170.0" style="-fx-background-radius: 15; " text="%read.totalPriceOrder.button" textFill="WHITE">
               <styleClass>
                  <String fx:value="label-font" />
                  <String fx:value="action" />
               </styleClass></Button>
         </children>
         <VBox.margin>
            <Insets top="30.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
